695:         /* ---- XOR instructions ---- */
696:         case 0x30:  /* XOR Eb,Gb */
697:         case 0x31:  /* XOR Ev,Gv */
698:         case 0x32:  /* XOR Gb,Eb */
699:         case 0x33:  /* XOR Gv,Ev */
700:             emit_mov_reg(0, 4);
701:             emit_bl((uint32_t)&dinstr_exec_one);
702:             has_native_instrs = 0;
703:             offset++;
704:             instr_count++;
705:             goto block_done;
706: 
707:         case 0x34:  /* XOR AL,Ib */
708:             emit_mov_reg(0, 4);
709:             emit_mov_imm(1, mem[offset + 1]);
710:             emit_bl((uint32_t)&dinstr_xor_al_imm8);
711:             offset += 2;
712:             break;
