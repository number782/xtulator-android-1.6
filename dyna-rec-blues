522:         case 0xC3:  /* RET (near) */
523:             emit_mov_reg(0, 4);
524:             emit_bl((uint32_t)&dinstr_ret_near);
525:             offset++;
526:             instr_count++;
527:             goto block_done;
528: 
529:         case 0xCD:  /* INT imm8 */
530:             emit_mov_reg(0, 4);
531:             emit_mov_imm(1, mem[offset + 1]);
532:             emit_bl((uint32_t)&dinstr_int);
533:             offset += 2;
534:             instr_count++;
535:             goto block_done;
536: 
537:         case 0xE8:  /* CALL rel16 */
538:             {
539:                 int16_t rel = mem[offset + 1] | (mem[offset + 2] << 8);
540:                 emit_mov_reg(0, 4);
541:                 emit_movw(1, (uint16_t)rel);
542:                 emit_bl((uint32_t)&dinstr_call_rel16);
543:             }
544:             offset += 3;
545:             instr_count++;
