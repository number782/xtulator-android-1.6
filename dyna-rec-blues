561:         case 0xEB:  /* JMP rel8 */
562:             emit_mov_reg(0, 4);
563:             emit_mov_imm(1, (uint8_t)mem[offset + 1]);
564:             emit_bl((uint32_t)&dinstr_jmp_rel8);
565:             offset += 2;
566:             instr_count++;
567:             goto block_done;
568: 
569:         case 0xF4:  /* HLT */
570:             emit_mov_reg(0, 4);
571:             emit_bl((uint32_t)&dinstr_hlt);
572:             offset++;
573:             instr_count++;
574:             goto block_done;
575: 
576:         /* ---- Segment register operations ---- */
577:         case 0x06:  /* PUSH ES */
578:             emit_mov_reg(0, 4);
579:             emit_bl((uint32_t)&dinstr_push_es);
580:             offset++;
581:             break;
582: 
583:         case 0x07:  /* POP ES */
584:             emit_mov_reg(0, 4);
585:             emit_bl((uint32_t)&dinstr_pop_es);
586:             offset++;
587:             break;
