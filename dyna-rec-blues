400: static void dynrec_getea(CPU_t* cpu, uint8_t rmval) {
401:     uint32_t tempea = 0;
402:     switch (cpu->mode) {
403:     case 0:
404:         switch (rmval) {
405:         case 0: tempea = cpu->regs.wordregs[regbx] + cpu->regs.wordregs[regsi]; break;
406:         case 1: tempea = cpu->regs.wordregs[regbx] + cpu->regs.wordregs[regdi]; break;
407:         case 2: tempea = cpu->regs.wordregs[regbp] + cpu->regs.wordregs[regsi]; break;
408:         case 3: tempea = cpu->regs.wordregs[regbp] + cpu->regs.wordregs[regdi]; break;
409:         case 4: tempea = cpu->regs.wordregs[regsi]; break;
410:         case 5: tempea = cpu->regs.wordregs[regdi]; break;
411:         case 6: tempea = cpu->disp16; break;
412:         case 7: tempea = cpu->regs.wordregs[regbx]; break;
413:         }
414:         break;
415:     case 1:
416:     case 2:
417:         switch (rmval) {
418:         case 0: tempea = cpu->regs.wordregs[regbx] + cpu->regs.wordregs[regsi] + cpu->disp16; break;
419:         case 1: tempea = cpu->regs.wordregs[regbx] + cpu->regs.wordregs[regdi] + cpu->disp16; break;
420:         case 2: tempea = cpu->regs.wordregs[regbp] + cpu->regs.wordregs[regsi] + cpu->disp16; break;
421:         case 3: tempea = cpu->regs.wordregs[regbp] + cpu->regs.wordregs[regdi] + cpu->disp16; break;
422:         case 4: tempea = cpu->regs.wordregs[regsi] + cpu->disp16; break;
423:         case 5: tempea = cpu->regs.wordregs[regdi] + cpu->disp16; break;
424:         case 6: tempea = cpu->regs.wordregs[regbp] + cpu->disp16; break;
425:         case 7: tempea = cpu->regs.wordregs[regbx] + cpu->disp16; break;
426:         }
427:         break;
428:     default:
429:         break;
430:     }
431:     cpu->ea = (uint32_t)(tempea & 0xFFFF) + (cpu->useseg << 4);
432: }
