450: static void dynrec_writerm8(CPU_t* cpu, uint8_t rmval, uint8_t value) {
451:     if (cpu->mode < 3) {
452:         dynrec_getea(cpu, rmval);
453:         cpu_write(cpu, cpu->ea, value);
454:     } else {
455:         cpu->regs.byteregs[byteregtable[rmval]] = value;
456:     }
457: }
