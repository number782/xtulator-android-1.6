442: static uint16_t dynrec_readrm16(CPU_t* cpu, uint8_t rmval) {
443:     if (cpu->mode < 3) {
444:         dynrec_getea(cpu, rmval);
445:         return cpu_read(cpu, cpu->ea) | ((uint16_t)cpu_read(cpu, cpu->ea + 1) << 8);
446:     }
447:     return cpu->regs.wordregs[rmval];
448: }
