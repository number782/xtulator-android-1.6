1010: void dynrec_invalidate_range(uint32_t start, uint32_t len) {
1011:     if (!dynrec_enabled) return;
1012:     uint32_t end = start + len;
1013:     for (int i = 0; i < block_cache_count; i++) {
1014:         uint32_t block_end = block_cache[i].x86_pc + block_cache[i].x86_len;
1015:         if (block_cache[i].x86_pc >= start && block_cache[i].x86_pc < end) {
1016:             block_cache[i].x86_pc = 0;
1017:         }
1018:     }
1019: }
