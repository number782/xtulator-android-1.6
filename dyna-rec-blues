539:         case 0xE8:  /* CALL rel16 */
540:             {
541:                 int16_t rel = mem[offset + 1] | (mem[offset + 2] << 8);
542:                 emit_mov_reg(0, 4);
543:                 emit_movw(1, (uint16_t)rel);
544:                 emit_bl((uint32_t)&dinstr_call_rel16);
545:             }
546:             offset += 3;
547:             instr_count++;
548:             goto block_done;
