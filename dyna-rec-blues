1021: int dynrec_exec(CPU_t* cpu, I8259_t* i8259, int max_instr) {
1022:     if (!dynrec_enabled) return 0;
1023: 
1024:     int total_executed = 0;
1025: 
1026:     while (total_executed < max_instr) {
1027:         /* Handle pending interrupts */
1028:         uint8_t pending = i8259->irr & (~i8259->imr);
1029:         if (!cpu->trap_toggle && cpu->ifl && pending) {
1030:             cpu->hltstate = 0;
1031:             cpu_intcall(cpu, i8259_nextintr(i8259));
1032:             continue;
1033:         }
1034: 
1035:         if (cpu->hltstate) {
1036:             cpu_exec(cpu, 100);
1037:             total_executed += 100;
1038:             continue;
1039:         }
1040: 
1041:         uint32_t x86_pc = (cpu->segregs[regcs] << 4) + cpu->ip;
1042:         block_entry_t* block = find_block(x86_pc);
1043: 
1044:     if (block == NULL || block->x86_pc == 0) {
1045:         int result = translate_block(cpu, x86_pc, MAX_INSTRUCTIONS);
1046:         if (result < 0 || result == 0) {
1047:             /* Can't translate or empty block — use interpreter */
1048:             int batch = (max_instr - total_executed);
1049:             if (batch > 1000) batch = 1000;
1050:             cpu_exec(cpu, batch);
1051:             dynrec_interpreter_instrs += batch;
1052:             total_executed += batch;
1053:             continue;
1054:         }
1055:         block = &block_cache[block_cache_count - 1];
1056:     }
1057: 
1058:     /* Flush data cache and invalidate instruction cache to ensure
1059:      * generated code is visible to the CPU. On ARMv5TE with Android,
1060:      * __builtin___clear_cache may not work reliably — use the
1061:      * cacheflush() syscall wrapper which issues the SWI directly. */
1062:     cacheflush((long)(code_cache_base + block->arm_offset),
1063:                (long)(code_cache_base + block->arm_offset + block->code_len),
1064:                0);
1065: 
1066:     /* Execute the translated block */
1067:     typedef void (*block_func_t)(CPU_t* cpu);
1068:     block_func_t func = (block_func_t)(code_cache_base + block->arm_offset);
