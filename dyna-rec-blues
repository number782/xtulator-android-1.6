967: void dynrec_init(void) {
968:     /* Start with dynrec disabled - must be explicitly enabled */
969:     code_cache_pos = 0;
970:     block_cache_count = 0;
971:     memset(block_cache, 0, sizeof(block_cache));
972:     dynrec_enabled = 0;
973:     DLOGI("dynrec: initialized (disabled by default - enable via setspeed or nativeRun)");
974: }
975: 
976: void dynrec_reset(void) {
977:     if (!dynrec_enabled) return;
978:     if (code_cache_base) {
979:         code_cache_pos = 0;
980:     }
981:     block_cache_count = 0;
982:     memset(block_cache, 0, sizeof(block_cache));
983:     DLOGI("dynrec: reset");
984: }
985: 
986: void dynrec_enable(void) {
987:     if (dynrec_enabled) return;
988:     if (code_cache_base == NULL) {
989:         code_cache_base = mmap(NULL, CODE_CACHE_SIZE,
990:                                PROT_READ | PROT_WRITE | PROT_EXEC,
991:                                MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
992:         if (code_cache_base == MAP_FAILED) {
993:             DLOGI("dynrec: mmap failed on enable");
994:             code_cache_base = NULL;
995:             return;
996:         }
997:     }
998:     code_cache_pos = 0;
999:     block_cache_count = 0;
1000:     memset(block_cache, 0, sizeof(block_cache));
1001:     dynrec_enabled = 1;
1002:     DLOGI("dynrec: enabled, code_cache_base=%p", code_cache_base);
1003: }
1004: 
1005: void dynrec_disable(void) {
1006:     dynrec_enabled = 0;
1007:     DLOGI("dynrec: disabled");
1008: }
