589:         /* ---- OR instructions ---- */
590:         case 0x08:  /* OR Eb,Gb */
591:         case 0x09:  /* OR Ev,Gv */
592:         case 0x0A:  /* OR Gb,Eb */
593:         case 0x0B:  /* OR Gv,Ev */
594:             emit_mov_reg(0, 4);
595:             emit_bl((uint32_t)&dinstr_exec_one);
596:             has_native_instrs = 0;
597:             offset++;
598:             instr_count++;
599:             goto block_done;
600: 
601:         case 0x0C:  /* OR AL,Ib */
602:             emit_mov_reg(0, 4);
603:             emit_mov_imm(1, mem[offset + 1]);
604:             emit_bl((uint32_t)&dinstr_or_al_imm8);
605:             offset += 2;
606:             break;
607: 
608:         case 0x0D:  /* OR AX,Iv */
609:             emit_mov_reg(0, 4);
610:             emit_movw(1, mem[offset + 1] | (mem[offset + 2] << 8));
611:             emit_bl((uint32_t)&dinstr_or_ax_imm16);
612:             offset += 3;
613:             break;
614: 
615:         case 0x0E:  /* PUSH CS */
616:             emit_mov_reg(0, 4);
617:             emit_bl((uint32_t)&dinstr_push_cs);
618:             offset++;
619:             break;
620: 
621:         /* ---- ADC instructions (0x10-0x15) ---- */
622:         case 0x10:  /* ADC Eb,Gb */
623:         case 0x11:  /* ADC Ev,Gv */
624:         case 0x12:  /* ADC Gb,Eb */
625:         case 0x13:  /* ADC Gv,Ev */
626:             emit_mov_reg(0, 4);
627:             emit_bl((uint32_t)&dinstr_exec_one);
628:             has_native_instrs = 0;
629:             offset++;
630:             instr_count++;
631:             goto block_done;
632: 
633:         case 0x14:  /* ADC AL,Ib */
634:             emit_mov_reg(0, 4);
635:             emit_mov_imm(1, mem[offset + 1]);
636:             emit_bl((uint32_t)&dinstr_adc_al_imm8);
637:             offset += 2;
638:             break;
639: 
640:         case 0x15:  /* ADC AX,Iv */
641:             emit_mov_reg(0, 4);
642:             emit_movw(1, mem[offset + 1] | (mem[offset + 2] << 8));
643:             emit_bl((uint32_t)&dinstr_adc_ax_imm16);
644:             offset += 3;
645:             break;
646: 
647:         /* ---- SBB instructions (0x18-0x1D) ---- */
648:         case 0x18:  /* SBB Eb,Gb */
649:         case 0x19:  /* SBB Ev,Gv */
650:         case 0x1A:  /* SBB Gb,Eb */
651:         case 0x1B:  /* SBB Gv,Ev */
652:             emit_mov_reg(0, 4);
653:             emit_bl((uint32_t)&dinstr_exec_one);
654:             has_native_instrs = 0;
655:             offset++;
656:             instr_count++;
657:             goto block_done;
658: 
659:         case 0x1C:  /* SBB AL,Ib */
660:             emit_mov_reg(0, 4);
661:             emit_mov_imm(1, mem[offset + 1]);
662:             emit_bl((uint32_t)&dinstr_sbb_al_imm8);
663:             offset += 2;
664:             break;
665: 
666:         case 0x1D:  /* SBB AX,Iv */
667:             emit_mov_reg(0, 4);
668:             emit_movw(1, mem[offset + 1] | (mem[offset + 2] << 8));
669:             emit_bl((uint32_t)&dinstr_sbb_ax_imm16);
670:             offset += 3;
671:             break;
672: 
673:         case 0x16:  /* PUSH SS */
674:             emit_mov_reg(0, 4);
675:             emit_bl((uint32_t)&dinstr_push_ss);
676:             offset++;
677:             break;
678: 
679:         case 0x17:  /* POP SS */
680:             emit_mov_reg(0, 4);
681:             emit_bl((uint32_t)&dinstr_pop_ss);
682:             offset++;
683:             break;
684: 
685:         case 0x1E:  /* PUSH DS */
686:             emit_mov_reg(0, 4);
687:             emit_bl((uint32_t)&dinstr_push_ds);
688:             offset++;
689:             break;
690: 
691:         case 0x1F:  /* POP DS */
692:             emit_mov_reg(0, 4);
693:             emit_bl((uint32_t)&dinstr_pop_ds);
694:             offset++;
695:             break;
696: 
697:         /* ---- XOR instructions ---- */
698:         case 0x30:  /* XOR Eb,Gb */
699:         case 0x31:  /* XOR Ev,Gv */
700:         case 0x32:  /* XOR Gb,Eb */
701:         case 0x33:  /* XOR Gv,Ev */
702:             emit_mov_reg(0, 4);
703:             emit_bl((uint32_t)&dinstr_exec_one);
704:             has_native_instrs = 0;
705:             offset++;
706:             instr_count++;
707:             goto block_done;
708: 
709:         case 0x34:  /* XOR AL,Ib */
710:             emit_mov_reg(0, 4);
711:             emit_mov_imm(1, mem[offset + 1]);
712:             emit_bl((uint32_t)&dinstr_xor_al_imm8);
713:             offset += 2;
714:             break;
715: 
716:         case 0x35:  /* XOR AX,Iv */
717:             emit_mov_reg(0, 4);
718:             emit_movw(1, mem[offset + 1] | (mem[offset + 2] << 8));
719:             emit_bl((uint32_t)&dinstr_xor_ax_imm16);
720:             offset += 3;
721:             break;
722: 
723:         /* ---- AND opcodes (0x20-0x25) ---- */
724:         case 0x20: case 0x21: case 0x22: case 0x23:
725:             /* AND Eb,Gb / AND Ev,Gv / AND Gb,Eb / AND Gv,Ev — ModR/M forms */
726:             emit_mov_reg(0, 4);
727:             emit_bl((uint32_t)&dinstr_exec_one);
728:             has_native_instrs = 0;
729:             offset++;
730:             instr_count++;
731:             goto block_done;
732: 
733:         case 0x24:  /* AND AL, Ib */
734:             emit_mov_reg(0, 4);
735:             emit_mov_imm(1, mem[offset + 1]);
736:             emit_bl((uint32_t)&dinstr_and_al_imm8);
737:             offset += 2;
738:             break;
739: 
740:         case 0x25:  /* AND AX, Iv */
741:             {
742:                 uint16_t imm = mem[offset + 1] | (mem[offset + 2] << 8);
743:                 emit_mov_reg(0, 4);
744:                 emit_movw(1, imm);
745:                 emit_bl((uint32_t)&dinstr_and_ax_imm16);
746:             }
747:             offset += 3;
748:             break;
749: 
750:         /* ---- SAHF/LAHF ---- */
751:         case 0x9E:  /* SAHF */
752:             emit_mov_reg(0, 4);
753:             emit_bl((uint32_t)&dinstr_sahf);
754:             offset++;
755:             break;
756: 
757:         case 0x9F:  /* LAHF */
758:             emit_mov_reg(0, 4);
759:             emit_bl((uint32_t)&dinstr_lahf);
760:             offset++;
761:             break;
762: 
763:         /* ---- Flag operations ---- */
764:         case 0xF0:  /* LOCK prefix — skip, no operation */
765:             offset++;
766:             break;
767: 
768:         case 0xF5:  /* CMC */
769:             emit_mov_reg(0, 4);
770:             emit_bl((uint32_t)&dinstr_cmc);
771:             offset++;
772:             break;
773: 
774:         case 0xF8:  /* CLC */
775:             emit_mov_reg(0, 4);
776:             emit_bl((uint32_t)&dinstr_clc);
777:             offset++;
778:             break;
779: 
780:         case 0xF9:  /* STC */
781:             emit_mov_reg(0, 4);
782:             emit_bl((uint32_t)&dinstr_stc);
783:             offset++;
784:             break;
785: 
786:         case 0xFA:  /* CLI */
787:             emit_mov_reg(0, 4);
788:             emit_bl((uint32_t)&dinstr_cli);
789:             offset++;
790:             break;
791: 
792:         case 0xFB:  /* STI */
793:             emit_mov_reg(0, 4);
794:             emit_bl((uint32_t)&dinstr_sti);
795:             offset++;
796:             break;
797: 
798:         case 0xFC:  /* CLD */
799:             emit_mov_reg(0, 4);
800:             emit_bl((uint32_t)&dinstr_cld);
801:             offset++;
802:             break;
803: 
804:         case 0xFD:  /* STD */
805:             emit_mov_reg(0, 4);
806:             emit_bl((uint32_t)&dinstr_std);
807:             offset++;
808:             break;
809: 
810:         /* ---- String operations — complex REP handling, fall back to interpreter ---- */
811:         case 0xA4:  /* MOVSB */
812:         case 0xA5:  /* MOVSW */
813:         case 0xAC:  /* LODSB */
814:         case 0xAD:  /* LODSW */
815:         case 0xAA:  /* STOSB */
816:         case 0xAB:  /* STOSW */
817:         case 0xA6:  /* CMPSB */
818:         case 0xA7:  /* CMPSW */
819:         case 0xAE:  /* SCASB */
820:         case 0xAF:  /* SCASW */
821:             emit_mov_reg(0, 4);
822:             emit_bl((uint32_t)&dinstr_exec_one);
823:             has_native_instrs = 0;
824:             offset++;
825:             instr_count++;
826:             goto block_done;
827: 
828:         /* ---- Conditional jumps (0x70-0x7F) ---- */
829:         case 0x70: case 0x71: case 0x72: case 0x73:
830:         case 0x74: case 0x75: case 0x76: case 0x77:
831:         case 0x78: case 0x79: case 0x7A: case 0x7B:
832:         case 0x7C: case 0x7D: case 0x7E: case 0x7F: {
833:             /* Jcond rel8 — condition evaluated at runtime via helper.
834:                The helper may modify cpu->ip if the jump is taken,
835:                so we must terminate the block to avoid executing
836:                wrong pre-translated instructions. */
837:             int8_t rel = (int8_t)mem[offset + 1];
838:             emit_mov_reg(0, 4);
839:             emit_mov_imm(1, opcode);
840:             emit_mov_imm(2, (uint8_t)rel);
841:             emit_bl((uint32_t)&dinstr_jcond_rel8);
842:             offset += 2;
843:             instr_count++;
844:             goto block_done;
845:         }
846: 
847:         /* ---- Opcodes 0x80-0x8F: ModR/M group and data-movement ---- */
848: 
849:         case 0x80: case 0x81: case 0x82: case 0x83:
850:             /* GRP1 Eb/Ib and Ev/Iv (ADD/OR/ADC/SBB/AND/SUB/XOR/CMP) — defer to interpreter */
851:             emit_mov_reg(0, 4);
852:             emit_bl((uint32_t)&dinstr_exec_one);
853:             has_native_instrs = 0;
854:             offset++;
855:             instr_count++;
856:             goto block_done;
857: 
858:         case 0x84:  /* TEST Gb, Eb */
859:             /* ModR/M-based — defer to interpreter */
860:             emit_mov_reg(0, 4);
861:             emit_bl((uint32_t)&dinstr_exec_one);
862:             has_native_instrs = 0;
863:             offset++;
864:             instr_count++;
865:             goto block_done;
866: 
867:         case 0x85:  /* TEST Gv, Ev */
868:             emit_mov_reg(0, 4);
869:             emit_bl((uint32_t)&dinstr_exec_one);
870:             has_native_instrs = 0;
871:             offset++;
872:             instr_count++;
873:             goto block_done;
874: 
875:         case 0x86:  /* XCHG Eb, Gb */
876:         case 0x87:  /* XCHG Ev, Gv */
877:         case 0x88:  /* MOV Eb, Gb */
878:         case 0x89:  /* MOV Ev, Gv */
879:         case 0x8A:  /* MOV Gb, Eb */
880:         case 0x8B:  /* MOV Gv, Ev */
881:             /* Full ModR/M r/m decode — defer to interpreter */
882:             emit_mov_reg(0, 4);
883:             emit_bl((uint32_t)&dinstr_exec_one);
884:             has_native_instrs = 0;
885:             offset++;
886:             instr_count++;
887:             goto block_done;
888: 
889:         case 0x8C:  /* MOV Ew, Sw */
890:             emit_mov_reg(0, 4);
891:             emit_bl((uint32_t)&dinstr_exec_one);
892:             has_native_instrs = 0;
893:             offset++;
894:             instr_count++;
895:             goto block_done;
896: 
897:         case 0x8D:  /* LEA Gv, M */
898:             emit_mov_reg(0, 4);
899:             emit_bl((uint32_t)&dinstr_exec_one);
900:             has_native_instrs = 0;
901:             offset++;
902:             instr_count++;
903:             goto block_done;
904: 
905:         case 0x8E:  /* MOV Sw, Ew */
906:             emit_mov_reg(0, 4);
907:             emit_bl((uint32_t)&dinstr_exec_one);
908:             has_native_instrs = 0;
909:             offset++;
910:             instr_count++;
911:             goto block_done;
912: 
913:         case 0x8F:  /* POP Ev */
914:             emit_mov_reg(0, 4);
915:             emit_bl((uint32_t)&dinstr_exec_one);
916:             has_native_instrs = 0;
917:             offset++;
918:             instr_count++;
919:             goto block_done;
920: 
921:         default:
922:             /* Unsupported opcode — bail out to interpreter */
923:             goto translate_fail;
924:         }
925: 
926:         if (emit32_failed) {
927:             goto translate_fail;
928:         }
929: 
930:         instr_count++;
931:     }
932: 
933: block_done:
934:     /* Check if code cache overflowed during translation */
935:     if (emit32_failed) {
936:         goto translate_fail;
937:     }
938: 
939:     /* Function epilogue */
940:     ARM_POP();  /* restore r4, r10, r11, pc */
941: 
942:     /* Store in block cache — but only if the block contains natively-translated
943:        instructions (not just interpreter fallbacks), since caching pure
944:        interpreter fallback blocks wastes cache entries. */
945:     if (has_native_instrs && block_cache_count < MAX_BLOCKS) {
946:         block_cache[block_cache_count].x86_pc = x86_pc;
947:         block_cache[block_cache_count].arm_offset = start_pos;
948:         block_cache[block_cache_count].code_len = code_cache_pos - start_pos;
949:         block_cache[block_cache_count].x86_len = offset;
950:         block_cache[block_cache_count].x86_end_ip = (uint16_t)(cpu->ip + offset);
951:         block_cache_count++;
952:     } else if (!has_native_instrs) {
953:         /* Block only contained interpreter fallbacks — return 0 so dynrec_exec
954:            falls back to interpreter directly (don't cache, don't execute). */
955:         code_cache_pos = start_pos;  /* discard emitted ARM code */
956:         return 0;
957:     }
958: 
959:     return instr_count;
960: 
961: translate_fail:
962:     /* Restore code cache position to discard any partially emitted garbage */
963:     code_cache_pos = start_pos;
964:     return -1;
965: }
