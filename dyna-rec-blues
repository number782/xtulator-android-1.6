721:         /* ---- AND opcodes (0x20-0x25) ---- */
722:         case 0x20: case 0x21: case 0x22: case 0x23:
723:             /* AND Eb,Gb / AND Ev,Gv / AND Gb,Eb / AND Gv,Ev — ModR/M forms */
724:             emit_mov_reg(0, 4);
725:             emit_bl((uint32_t)&dinstr_exec_one);
726:             has_native_instrs = 0;
727:             offset++;
728:             instr_count++;
729:             goto block_done;
730: 
731:         case 0x24:  /* AND AL, Ib */
732:             emit_mov_reg(0, 4);
733:             emit_mov_imm(1, mem[offset + 1]);
734:             emit_bl((uint32_t)&dinstr_and_al_imm8);
735:             offset += 2;
736:             break;
737: 
738:         case 0x25:  /* AND AX, Iv */
739:             {
740:                 uint16_t imm = mem[offset + 1] | (mem[offset + 2] << 8);
741:                 emit_mov_reg(0, 4);
742:                 emit_movw(1, imm);
743:                 emit_bl((uint32_t)&dinstr_and_ax_imm16);
744:             }
745:             offset += 3;
746:             break;
747: 
748:         /* ---- SAHF/LAHF ---- */
749:         case 0x9E:  /* SAHF */
750:             emit_mov_reg(0, 4);
751:             emit_bl((uint32_t)&dinstr_sahf);
752:             offset++;
753:             break;
754: 
755:         case 0x9F:  /* LAHF */
756:             emit_mov_reg(0, 4);
757:             emit_bl((uint32_t)&dinstr_lahf);
758:             offset++;
759:             break;
760: 
761:         /* ---- Flag operations ---- */
762:         case 0xF0:  /* LOCK prefix — skip, no operation */
763:             offset++;
764:             break;
765: 
766:         case 0xF5:  /* CMC */
767:             emit_mov_reg(0, 4);
768:             emit_bl((uint32_t)&dinstr_cmc);
769:             offset++;
770:             break;
771: 
772:         case 0xF8:  /* CLC */
773:             emit_mov_reg(0, 4);
774:             emit_bl((uint32_t)&dinstr_clc);
775:             offset++;
776:             break;
777: 
778:         case 0xF9:  /* STC */
779:             emit_mov_reg(0, 4);
780:             emit_bl((uint32_t)&dinstr_stc);
781:             offset++;
782:             break;
783: 
784:         case 0xFA:  /* CLI */
785:             emit_mov_reg(0, 4);
786:             emit_bl((uint32_t)&dinstr_cli);
787:             offset++;
788:             break;
789: 
790:         case 0xFB:  /* STI */
791:             emit_mov_reg(0, 4);
792:             emit_bl((uint32_t)&dinstr_sti);
793:             offset++;
794:             break;
795: 
796:         case 0xFC:  /* CLD */
797:             emit_mov_reg(0, 4);
798:             emit_bl((uint32_t)&dinstr_cld);
799:             offset++;
800:             break;
801: 
802:         case 0xFD:  /* STD */
803:             emit_mov_reg(0, 4);
804:             emit_bl((uint32_t)&dinstr_std);
805:             offset++;
806:             break;
807: 
808:         /* ---- String operations — complex REP handling, fall back to interpreter ---- */
809:         case 0xA4:  /* MOVSB */
810:         case 0xA5:  /* MOVSW */
811:         case 0xAC:  /* LODSB */
812:         case 0xAD:  /* LODSW */
813:         case 0xAA:  /* STOSB */
814:         case 0xAB:  /* STOSW */
815:         case 0xA6:  /* CMPSB */
816:         case 0xA7:  /* CMPSW */
817:         case 0xAE:  /* SCASB */
818:         case 0xAF:  /* SCASW */
819:             emit_mov_reg(0, 4);
820:             emit_bl((uint32_t)&dinstr_exec_one);
821:             has_native_instrs = 0;
822:             offset++;
823:             instr_count++;
824:             goto block_done;
825: 
826:         /* ---- Conditional jumps (0x70-0x7F) ---- */
827:         case 0x70: case 0x71: case 0x72: case 0x73:
828:         case 0x74: case 0x75: case 0x76: case 0x77:
829:         case 0x78: case 0x79: case 0x7A: case 0x7B:
830:         case 0x7C: case 0x7D: case 0x7E: case 0x7F: {
831:             /* Jcond rel8 — condition evaluated at runtime via helper.
832:                The helper may modify cpu->ip if the jump is taken,
833:                so we must terminate the block to avoid executing
834:                wrong pre-translated instructions. */
835:             int8_t rel = (int8_t)mem[offset + 1];
836:             emit_mov_reg(0, 4);
837:             emit_mov_imm(1, opcode);
838:             emit_mov_imm(2, (uint8_t)rel);
839:             emit_bl((uint32_t)&dinstr_jcond_rel8);
840:             offset += 2;
841:             instr_count++;
842:             goto block_done;
843:         }
844: 
845:         /* ---- Opcodes 0x80-0x8F: ModR/M group and data-movement ---- */
846: 
847:         case 0x80: case 0x81: case 0x82: case 0x83:
848:             /* GRP1 Eb/Ib and Ev/Iv (ADD/OR/ADC/SBB/AND/SUB/XOR/CMP) — defer to interpreter */
849:             emit_mov_reg(0, 4);
850:             emit_bl((uint32_t)&dinstr_exec_one);
851:             has_native_instrs = 0;
852:             offset++;
853:             instr_count++;
854:             goto block_done;
855: 
856:         case 0x84:  /* TEST Gb, Eb */
857:             /* ModR/M-based — defer to interpreter */
858:             emit_mov_reg(0, 4);
859:             emit_bl((uint32_t)&dinstr_exec_one);
860:             has_native_instrs = 0;
861:             offset++;
862:             instr_count++;
863:             goto block_done;
864: 
865:         case 0x85:  /* TEST Gv, Ev */
866:             emit_mov_reg(0, 4);
867:             emit_bl((uint32_t)&dinstr_exec_one);
868:             has_native_instrs = 0;
869:             offset++;
870:             instr_count++;
871:             goto block_done;
872: 
873:         case 0x86:  /* XCHG Eb, Gb */
874:         case 0x87:  /* XCHG Ev, Gv */
875:         case 0x88:  /* MOV Eb, Gb */
876:         case 0x89:  /* MOV Ev, Gv */
877:         case 0x8A:  /* MOV Gb, Eb */
878:         case 0x8B:  /* MOV Gv, Ev */
879:             /* Full ModR/M r/m decode — defer to interpreter */
880:             emit_mov_reg(0, 4);
881:             emit_bl((uint32_t)&dinstr_exec_one);
882:             has_native_instrs = 0;
883:             offset++;
884:             instr_count++;
885:             goto block_done;
886: 
887:         case 0x8C:  /* MOV Ew, Sw */
888:             emit_mov_reg(0, 4);
889:             emit_bl((uint32_t)&dinstr_exec_one);
890:             has_native_instrs = 0;
891:             offset++;
892:             instr_count++;
893:             goto block_done;
894: 
895:         case 0x8D:  /* LEA Gv, M */
896:             emit_mov_reg(0, 4);
897:             emit_bl((uint32_t)&dinstr_exec_one);
898:             has_native_instrs = 0;
899:             offset++;
900:             instr_count++;
901:             goto block_done;
902: 
903:         case 0x8E:  /* MOV Sw, Ew */
904:             emit_mov_reg(0, 4);
905:             emit_bl((uint32_t)&dinstr_exec_one);
906:             has_native_instrs = 0;
907:             offset++;
908:             instr_count++;
909:             goto block_done;
910: 
911:         case 0x8F:  /* POP Ev */
912:             emit_mov_reg(0, 4);
913:             emit_bl((uint32_t)&dinstr_exec_one);
914:             has_native_instrs = 0;
915:             offset++;
916:             instr_count++;
917:             goto block_done;
918: 
919:         default:
920:             /* Unsupported opcode — bail out to interpreter */
921:             goto translate_fail;
922:         }
923: 
924:         if (emit32_failed) {
925:             goto translate_fail;
926:         }
927: 
928:         instr_count++;
929:     }
930: 
931: block_done:
932:     /* Check if code cache overflowed during translation */
933:     if (emit32_failed) {
934:         goto translate_fail;
935:     }
936: 
937:     /* Function epilogue */
938:     ARM_POP();  /* restore r4, r10, r11, pc */
939: 
940:     /* Store in block cache — but only if the block contains natively-translated
941:        instructions (not just interpreter fallbacks), since caching pure
942:        interpreter fallback blocks wastes cache entries. */
943:     if (has_native_instrs && block_cache_count < MAX_BLOCKS) {
944:         block_cache[block_cache_count].x86_pc = x86_pc;
945:         block_cache[block_cache_count].arm_offset = start_pos;
946:         block_cache[block_cache_count].code_len = code_cache_pos - start_pos;
947:         block_cache[block_cache_count].x86_len = offset;
948:         block_cache[block_cache_count].x86_end_ip = (uint16_t)(cpu->ip + offset);
949:         block_cache_count++;
950:     } else if (!has_native_instrs) {
951:         /* Block only contained interpreter fallbacks — return 0 so dynrec_exec
952:            falls back to interpreter directly (don't cache, don't execute). */
953:         code_cache_pos = start_pos;  /* discard emitted ARM code */
954:         return 0;
955:     }
956: 
957:     return instr_count;
958: 
959: translate_fail:
960:     /* Restore code cache position to discard any partially emitted garbage */
961:     code_cache_pos = start_pos;
962:     return -1;
963: }
964: 
965: void dynrec_init(void) {
966:     /* Start with dynrec disabled - must be explicitly enabled */
967:     code_cache_pos = 0;
968:     block_cache_count = 0;
969:     memset(block_cache, 0, sizeof(block_cache));
970:     dynrec_enabled = 0;
971:     DLOGI("dynrec: initialized (disabled by default - enable via setspeed or nativeRun)");
