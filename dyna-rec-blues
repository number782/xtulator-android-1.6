559:         case 0xEB:  /* JMP rel8 */
560:             emit_mov_reg(0, 4);
561:             emit_mov_imm(1, (uint8_t)mem[offset + 1]);
562:             emit_bl((uint32_t)&dinstr_jmp_rel8);
563:             offset += 2;
564:             instr_count++;
565:             goto block_done;
566: 
567:         case 0xF4:  /* HLT */
568:             emit_mov_reg(0, 4);
569:             emit_bl((uint32_t)&dinstr_hlt);
570:             offset++;
571:             instr_count++;
572:             goto block_done;
573: 
574:         /* ---- Segment register operations ---- */
575:         case 0x06:  /* PUSH ES */
576:             emit_mov_reg(0, 4);
577:             emit_bl((uint32_t)&dinstr_push_es);
578:             offset++;
579:             break;
580: 
581:         case 0x07:  /* POP ES */
582:             emit_mov_reg(0, 4);
583:             emit_bl((uint32_t)&dinstr_pop_es);
584:             offset++;
585:             break;
586: 
587:         /* ---- OR instructions ---- */
588:         case 0x08:  /* OR Eb,Gb */
589:         case 0x09:  /* OR Ev,Gv */
590:         case 0x0A:  /* OR Gb,Eb */
591:         case 0x0B:  /* OR Gv,Ev */
592:             emit_mov_reg(0, 4);
593:             emit_bl((uint32_t)&dinstr_exec_one);
594:             has_native_instrs = 0;
595:             offset++;
596:             instr_count++;
597:             goto block_done;
598: 
599:         case 0x0C:  /* OR AL,Ib */
600:             emit_mov_reg(0, 4);
601:             emit_mov_imm(1, mem[offset + 1]);
602:             emit_bl((uint32_t)&dinstr_or_al_imm8);
603:             offset += 2;
604:             break;
605: 
606:         case 0x0D:  /* OR AX,Iv */
607:             emit_mov_reg(0, 4);
608:             emit_movw(1, mem[offset + 1] | (mem[offset + 2] << 8));
609:             emit_bl((uint32_t)&dinstr_or_ax_imm16);
610:             offset += 3;
611:             break;
612: 
613:         case 0x0E:  /* PUSH CS */
614:             emit_mov_reg(0, 4);
615:             emit_bl((uint32_t)&dinstr_push_cs);
616:             offset++;
617:             break;
618: 
619:         /* ---- ADC instructions (0x10-0x15) ---- */
620:         case 0x10:  /* ADC Eb,Gb */
621:         case 0x11:  /* ADC Ev,Gv */
622:         case 0x12:  /* ADC Gb,Eb */
623:         case 0x13:  /* ADC Gv,Ev */
624:             emit_mov_reg(0, 4);
625:             emit_bl((uint32_t)&dinstr_exec_one);
626:             has_native_instrs = 0;
627:             offset++;
628:             instr_count++;
629:             goto block_done;
630: 
631:         case 0x14:  /* ADC AL,Ib */
632:             emit_mov_reg(0, 4);
633:             emit_mov_imm(1, mem[offset + 1]);
634:             emit_bl((uint32_t)&dinstr_adc_al_imm8);
635:             offset += 2;
636:             break;
637: 
638:         case 0x15:  /* ADC AX,Iv */
639:             emit_mov_reg(0, 4);
640:             emit_movw(1, mem[offset + 1] | (mem[offset + 2] << 8));
641:             emit_bl((uint32_t)&dinstr_adc_ax_imm16);
642:             offset += 3;
643:             break;
644: 
645:         /* ---- SBB instructions (0x18-0x1D) ---- */
646:         case 0x18:  /* SBB Eb,Gb */
647:         case 0x19:  /* SBB Ev,Gv */
648:         case 0x1A:  /* SBB Gb,Eb */
649:         case 0x1B:  /* SBB Gv,Ev */
650:             emit_mov_reg(0, 4);
651:             emit_bl((uint32_t)&dinstr_exec_one);
652:             has_native_instrs = 0;
653:             offset++;
654:             instr_count++;
655:             goto block_done;
656: 
657:         case 0x1C:  /* SBB AL,Ib */
658:             emit_mov_reg(0, 4);
659:             emit_mov_imm(1, mem[offset + 1]);
660:             emit_bl((uint32_t)&dinstr_sbb_al_imm8);
661:             offset += 2;
662:             break;
663: 
664:         case 0x1D:  /* SBB AX,Iv */
665:             emit_mov_reg(0, 4);
666:             emit_movw(1, mem[offset + 1] | (mem[offset + 2] << 8));
667:             emit_bl((uint32_t)&dinstr_sbb_ax_imm16);
668:             offset += 3;
669:             break;
670: 
671:         case 0x16:  /* PUSH SS */
672:             emit_mov_reg(0, 4);
673:             emit_bl((uint32_t)&dinstr_push_ss);
674:             offset++;
675:             break;
676: 
677:         case 0x17:  /* POP SS */
678:             emit_mov_reg(0, 4);
679:             emit_bl((uint32_t)&dinstr_pop_ss);
680:             offset++;
681:             break;
682: 
683:         case 0x1E:  /* PUSH DS */
684:             emit_mov_reg(0, 4);
685:             emit_bl((uint32_t)&dinstr_push_ds);
686:             offset++;
687:             break;
688: 
689:         case 0x1F:  /* POP DS */
690:             emit_mov_reg(0, 4);
691:             emit_bl((uint32_t)&dinstr_pop_ds);
692:             offset++;
693:             break;
