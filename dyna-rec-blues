714:         case 0x35:  /* XOR AX,Iv */
715:             emit_mov_reg(0, 4);
716:             emit_movw(1, mem[offset + 1] | (mem[offset + 2] << 8));
717:             emit_bl((uint32_t)&dinstr_xor_ax_imm16);
718:             offset += 3;
719:             break;
