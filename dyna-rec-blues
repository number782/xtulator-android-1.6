501:         case 0x58: case 0x59: case 0x5A: case 0x5B:
502:         case 0x5C: case 0x5D: case 0x5E: case 0x5F:
503:             /* POP eXX */
504:             emit_mov_reg(0, 4);
505:             emit_movw(1, (uint16_t)(opcode - 0x58));
506:             emit_bl((uint32_t)&dinstr_pop_r16);
