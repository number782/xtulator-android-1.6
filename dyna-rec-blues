459: static void dynrec_writerm16(CPU_t* cpu, uint8_t rmval, uint16_t value) {
460:     if (cpu->mode < 3) {
461:         dynrec_getea(cpu, rmval);
462:         cpu_write(cpu, cpu->ea, value & 0xFF);
463:         cpu_write(cpu, cpu->ea + 1, value >> 8);
464:     } else {
465:         cpu->regs.wordregs[rmval] = value;
466:     }
467: }
