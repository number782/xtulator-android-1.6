434: static uint8_t dynrec_readrm8(CPU_t* cpu, uint8_t rmval) {
435:     if (cpu->mode < 3) {
436:         dynrec_getea(cpu, rmval);
437:         return cpu_read(cpu, cpu->ea);
438:     }
439:     return cpu->regs.byteregs[byteregtable[rmval]];
440: }
