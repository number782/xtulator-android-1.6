             if (fd >= 0) {
@@ -118,6 +174,7 @@
 		memory_mapRead[start + i] = (readb == NULL) ? NULL : readb + i;
 		memory_mapWrite[start + i] = (writeb == NULL) ? NULL : writeb + i;
